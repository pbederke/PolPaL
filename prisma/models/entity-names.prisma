// -------------------------------------------------------------------------
// Entity Names
// -------------------------------------------------------------------------

model EntityNames {
  // ID and primary key
  // This is the unique identifier for each entity name in the database
  entityNameId Int @id @default(autoincrement())

  // Entity information
  polpalId Int // The ID of the entity

  // Name information
  nameShort    String // The short name of the entity
  name         String // The name of the entity
  language LanguageCodeEnum // The language of the name - ISO 639-1 language code

  // Additional information
  comment      String? // A comment about the name (optional)

  // Time frame
  startYear  Int? // The year when the name started being used (optional)
  startMonth Int? // The month when the name started being used (optional)
  startDay   Int? // The day when the name started being used (optional)
  endYear    Int? // The year when the name stopped being used (optional)
  endMonth   Int? // The month when the name stopped being used (optional)
  endDay     Int? // The day when the name stopped being used (optional)

  // Relations
  Entities   Entities     @relation("EntityNames", fields: [polpalId], references: [polpalId], onDelete: Cascade)
  References References[] @relation("EntityNameReferences") // The references associated with the entity name

  // Metadata
  createdAt DateTime @default(now()) // The date and time when the entity name was created
  updatedAt DateTime @updatedAt // The date and time when the entity name was last updated

  // User information
  user           Users? @relation("CreatedEntityNames", fields: [userId], references: [userId], onDelete: SetNull) // The user who created the entity name
  userId         Int? // The ID of the user who created the entity name

  @@index([polpalId])
  @@index([userId])
}

